{
  "name": "FeedbackStat",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "description": "Local calendar date in YYYY-MM-DD form; the rate-limit key."
    },
    "count": {
      "type": "number",
      "default": 0,
      "description": "Number of feedback messages submitted on this date across all callers."
    },
    "ips": {
      "type": "object",
      "default": {},
      "description": "Per-caller-IP-hash submission counts for this date, used to rate-limit the public feedback endpoint so a stranger can't spam the owner inbox. Hashed, not raw, for privacy.",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}