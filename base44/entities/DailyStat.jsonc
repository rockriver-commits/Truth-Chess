{
  "name": "DailyStat",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "description": "Local calendar date in YYYY-MM-DD form; the counter key."
    },
    "count": {
      "type": "number",
      "default": 0,
      "description": "Number of games played on this date across all modes."
    },
    "ips": {
      "type": "object",
      "default": {},
      "description": "Per-caller-IP-hash increment counts for this date, used to rate-limit public increments so a stranger can't inflate the counter. Hashed, not raw, for privacy.",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}