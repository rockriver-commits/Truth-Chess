    },
    "from": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "to": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "mateIn": {
      "type": "number",
      "description": "Winner moves remaining to mate from this position."
    }
  },
  "required": [
    "position_key",
    "from",
    "to",
    "mateIn"
  ]
}