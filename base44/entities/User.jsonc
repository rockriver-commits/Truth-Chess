{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "description": "Subscription tier: 'pro' unlocks full AI levels and unlimited online play.",
      "enum": [
        "free",
        "pro"
      ],
      "default": "free"
    },
    "games_played": {
      "type": "number",
      "description": "Completed games by this user.",
      "default": 0
    },
    "bonus_games": {
      "type": "number",
      "description": "Achievement points earned by beating the computer / first mate of the day.",
      "default": 0
    },
    "last_mate_date": {
      "type": "string",
      "description": "Local date (YYYY-MM-DD) of the player's last checkmate win, for the first-mate-of-the-day reward.",
      "default": ""
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}